# ─────────────────────────────────────────
# AgroMind - Variables de entorno
# Copia este archivo a .env y rellena los valores
# ─────────────────────────────────────────

# Base de datos PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/agromind?schema=public"

# Clerk - Autenticación
# Obtener en: https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Anthropic - Claude API
# Obtener en: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx

# Open-Meteo: sin API key, es gratuita
# OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
